# ==============================================================================
# Supabase Configuration
# احصل على هذه القيم من لوحة تحكم Supabase: Project Settings > API
# ==============================================================================

# عنوان المشروع (متاح للواجهة الأمامية والخلفية)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# المفتاح العام (Anon Key - آمن للاستخدام في المتصفح مع RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# المفتاح السري للخادم (Service Role Key - سري جداً! لا يوضع في Frontend إطلاقاً!)
# يُستخدم فقط في Backend API Routes لإنشاء وتعديل حسابات الموظفات في Supabase Auth
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
