rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة مساعدة للتحقق من دور المستخدم من مجموعة users أو profiles
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
            ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role
            : 'none');
    }

    // دالة مساعدة للتحقق مما إذا كان المستخدم مديراً
    function isManager() {
      return request.auth != null && getUserRole() == 'manager';
    }

    // قواعد حماية مجموعة المستخدمين (users/{userId})
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
      allow create, update: if request.auth != null && (request.auth.uid == userId || isManager());
      allow delete: if isManager();
    }

    // قواعد حماية الملفات الشخصية (profiles/{userId})
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
      allow create, update: if request.auth != null && (request.auth.uid == userId || isManager());
      allow delete: if isManager();
    }

    // قواعد حماية المهام (tasks/{taskId})
    match /tasks/{taskId} {
      // الموظفة تقرأ وتعدل وتحذف مهامها الخاصة فقط
      // المديرة تقرأ وتعدل وتتحكم في جميع المهام
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || isManager());
      allow create: if request.auth != null && (request.resource.data.user_id == request.auth.uid || isManager());
      allow update, delete: if request.auth != null && (resource.data.user_id == request.auth.uid || isManager());
    }
  }
}
