rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // دالة مساعدة للتحقق من دور المستخدم من مجموعة users أو profiles
    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : (exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
            ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role
            : 'none');
    }

    // دالة مساعدة للتحقق مما إذا كان المستخدم مديراً
    function isManager() {
      return request.auth != null && getUserRole() == 'manager';
    }

    // دالة مساعدة للتحقق من أن المستخدم موظف مسند إليه المهمة
    function isTaskAssignee(taskData) {
      return request.auth != null && taskData.user_id == request.auth.uid;
    }

    // دالة مساعدة لفحص أن الموظفة لم تغير الحقول الأصلية المحمية للمهمة
    function employeeKeptOriginalFields(existing, incoming) {
      return incoming.title == existing.title &&
             incoming.description == existing.description &&
             incoming.user_id == existing.user_id &&
             incoming.created_at == existing.created_at &&
             (!('created_by' in existing) || incoming.created_by == existing.created_by) &&
             (!('manager_note' in existing) || incoming.manager_note == existing.manager_note);
    }

    // قواعد حماية مجموعة المستخدمين (users/{userId})
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
      allow create, update: if request.auth != null && (request.auth.uid == userId || isManager());
      allow delete: if isManager();
    }

    // قواعد حماية الملفات الشخصية (profiles/{userId})
    match /profiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isManager());
      allow create, update: if request.auth != null && (request.auth.uid == userId || isManager());
      allow delete: if isManager();
    }

    // قواعد حماية المهام (tasks/{taskId})
    match /tasks/{taskId} {
      // القراءة: المديرة تقرأ كل المهام، الموظفة تقرأ مهامها المسندة إليها فقط
      allow read: if request.auth != null && (isManager() || resource.data.user_id == request.auth.uid);

      // الإنشاء: المديرة تنشئ المهام وتكلف الموظفات
      allow create: if request.auth != null && (isManager() || request.resource.data.user_id == request.auth.uid);

      // التعديل:
      // المديرة تعدل بحرية
      // الموظفة تعدل فقط إذا كانت المهمة مسندة لها ولم تغير البيانات الأصلية (تعديل الحالة، المرفقات، ملاحظة الإنجاز)
      allow update: if request.auth != null && (
        isManager() ||
        (isTaskAssignee(resource.data) && employeeKeptOriginalFields(resource.data, request.resource.data))
      );

      // الحذف: محصور تماماً بالمديرة فقط
      allow delete: if isManager();

      // المحادثات اللحظية داخل المهمة
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          isManager() ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.user_id == request.auth.uid
        );
        allow create: if request.auth != null && (
          isManager() ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.user_id == request.auth.uid
        ) && request.resource.data.sender_id == request.auth.uid;
        allow update: if request.auth != null && (
          isManager() ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.user_id == request.auth.uid
        );
        allow delete: if isManager();
      }

      // سجل النشاط (Activity Log) - لا يمكن حذفه أو التلاعب به
      match /activities/{activityId} {
        allow read: if request.auth != null && (
          isManager() ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.user_id == request.auth.uid
        );
        allow create: if request.auth != null && (
          isManager() ||
          get(/databases/$(database)/documents/tasks/$(taskId)).data.user_id == request.auth.uid
        );
        allow update: if false; // ممنوع التعديل قطعياً للحفاظ على سلامة وتاريخ السجل
        allow delete: if false; // ممنوع الحذف قطعياً للحفاظ على سلامة وتاريخ السجل
      }
    }

    // قواعد حماية الإشعارات (notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.user_id == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.user_id == request.auth.uid || isManager());
    }
  }
}

